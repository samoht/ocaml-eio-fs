# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Filesystem helpers and an in-memory backend for Eio"
description: """
eio-fs is an in-memory filesystem for Eio, with wrappers that inject
faults and simulate power loss for crash-consistency tests. It also writes
files atomically and durably on any backend, binds POSIX calls that Eio
lacks, and embeds a directory tree in a program. The in-memory backend is
adapted from Patrick Ferris's eio_mem (https://git.sirref.org/eio_mem)."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: [
  "Thomas Gazagnaire <thomas@gazagnaire.org>"
  "Thomas Leonard"
  "Patrick Ferris"
]
license: "ISC"
tags: ["eio" "filesystem" "in-memory"]
homepage: "https://github.com/samoht/ocaml-eio-fs"
bug-reports: "https://github.com/samoht/ocaml-eio-fs/issues"
depends: [
  "dune" {>= "3.21"}
  "hermetic" {>= "0.1.0"}
  "ocaml" {>= "5.3"}
  "eio" {>= "1.6"}
  "fmt"
  "cstruct"
  "optint"
  "mtime"
  "psq"
  "domain-local-await"
  "uucp"
  "uunf"
  "cmdliner" {>= "1.1.0"}
  "eio_main"
  "conf-linux-libc-dev" {os = "linux"}
  "mdx" {with-test & >= "2.3.0"}
  "alcotest" {with-test & >= "1.7.0"}
  "alcobar" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-eio-fs.git"
x-maintenance-intent: ["(latest)"]
available: os != "win32"
