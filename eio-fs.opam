# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Filesystem helpers and an in-memory backend for Eio"
description: """
Helpers for standard [Eio.Path] values and an in-memory filesystem backend.
   [Eio_fs.Fs.v ()] creates a fresh filesystem, [Eio_fs.Fs.load] populates it
   from an existing directory tree, and [Eio_fs.Fs.tree] renders a filesystem
   tree. The [eio-fs-crunch] binary embeds a directory tree as an OCaml
   module that rebuilds it in memory at runtime, in the style of ocaml-crunch.
   Adapted from Patrick Ferris's eio_mem
   (https://tangled.org/patrick.sirref.org/eio_mem), which is itself derived
   from the Eio filesystem interfaces."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Leonard" "Patrick Ferris"]
license: "ISC"
tags: ["org:blacksun" "system"]
homepage: "https://tangled.org/gazagnaire.org/ocaml-eio-fs"
bug-reports: "https://tangled.org/gazagnaire.org/ocaml-eio-fs/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1"}
  "eio"
  "fmt"
  "fpath"
  "cstruct"
  "optint"
  "console"
  "cmdliner"
  "eio_main"
  "mdx" {with-test}
  "alcotest" {with-test}
  "alcobar" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/gazagnaire.org/ocaml-eio-fs"
x-maintenance-intent: ["(latest)"]
pin-depends: [
  ["cstruct.6.2.0" "git+https://github.com/samoht/ocaml-cstruct.git#d1e1f46bd0711d301a613411ef325160c0d8b21c"]
  ["optint.0.3.0" "git+https://github.com/samoht/optint.git#ffb8eb0e3bbfca3089bc5b015cc5dfab8c0f8dd3"]
]
