# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Filesystem helpers and an in-memory backend for Eio"
description: """
Helpers for standard [Eio.Path] values and an in-memory filesystem backend.
   [Eio_fs.Fs.v ()] creates a fresh filesystem, [Eio_fs.Fs.load] populates it
   from an existing directory tree, and [Eio_fs.Fs.tree] renders a filesystem
   tree. Adapted from Patrick Ferris's eio_mem
   (https://tangled.org/patrick.sirref.org/eio_mem), which is itself derived
   from the Eio filesystem interfaces."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Leonard" "Patrick Ferris"]
license: "ISC"
tags: ["org:blacksun" "system"]
homepage: "https://tangled.org/gazagnaire.org/ocaml-eio-fs"
bug-reports: "https://tangled.org/gazagnaire.org/ocaml-eio-fs/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1"}
  "eio"
  "fmt"
  "cstruct"
  "optint"
  "eio_main" {with-test}
  "mdx" {with-test}
  "alcotest" {with-test}
  "alcobar" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://tangled.org/gazagnaire.org/ocaml-eio-fs"
x-maintenance-intent: ["(latest)"]
