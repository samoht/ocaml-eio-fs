; eio-fs.unix: the POSIX durability barrier at full platform strength,
; advisory file locking, and filesystem capacity. A separate library so the
; portable machinery (eio-fs.sync) and the in-memory backend stay free of
; unix.

(library
 (name eio_fs_unix)
 (public_name eio-fs.unix)
 (foreign_stubs
  (language c)
  (names eio_fs_unix_stubs)
  (flags
   (:standard
    -std=gnu11
    -Wall
    -Wextra
    (:include c_werror.sexp))))
 (libraries
  eio
  eio.unix
  eio-fs
  eio-fs.path
  eio-fs.sync
  cstruct
  fmt
  optint
  threads.posix
  unix)
 (c_library_flags
  (:standard
   (:include repro_link_flags.sexp))))

(rule
 (target repro_link_flags.sexp)
 (enabled_if
  (= %{system} macosx))
 (action
  (with-stdout-to
   %{target}
   (echo "(-Wl,-oso_prefix,.)"))))

(rule
 (target repro_link_flags.sexp)
 (enabled_if
  (<> %{system} macosx))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))

; Warnings are errors in development only: a compiler that warns about
; something new must not fail an installation.

(rule
 (target c_werror.sexp)
 (enabled_if
  (= %{profile} dev))
 (action
  (with-stdout-to
   %{target}
   (echo "(-Werror)"))))

(rule
 (target c_werror.sexp)
 (enabled_if
  (<> %{profile} dev))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))
