; eio-fs.unix: the POSIX durability barrier. A separate library so the
; portable machinery (eio-fs.sync) and the in-memory backend stay free of
; unix.

(library
 (name eio_fs_unix)
 (public_name eio-fs.unix)
 (foreign_stubs
  (language c)
  (names eio_fs_unix_stubs)
  (flags
   (:standard -std=gnu11 -Wall -Wextra -Werror)))
 (libraries eio eio.unix eio-fs.sync optint unix))
