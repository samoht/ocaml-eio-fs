; Crowbar fuzz testing for the chaos filesystem wrapper
;
; Quick check: dune build @fuzz
; With AFL: crow start --cpus=4

; Extents is private to eio_fs: its source is compiled in here.

(copy_files#
 (files ../lib/extents.{ml,mli}))

(executable
 (name fuzz)
 (libraries eio eio.mock eio_fs eio-fs.sync alcobar fmt cstruct optint))

(rule
 (alias runtest)
 (enabled_if
  (<> %{profile} afl))
 (deps fuzz.exe)
 (action
  (run %{exe:fuzz.exe})))

(rule
 (alias fuzz)
 (enabled_if
  (= %{profile} afl))
 (deps fuzz.exe)
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run afl-fuzz -V 60 -i corpus -o _fuzz -- %{exe:fuzz.exe} @@))))
