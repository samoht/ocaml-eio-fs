The generator embeds a directory tree: files, permissions, symbolic
links and empty directories -- as an OCaml module.

  $ umask 022
  $ mkdir -p tree/static
  $ printf 'hello\n' > tree/index.html
  $ printf '#!/bin/sh\n' > tree/run.sh
  $ chmod 755 tree/run.sh
  $ printf 'body {}\n' > tree/static/site.css
  $ ln -s index.html tree/link

  $ eio-fs-crunch tree
  (* Generated by eio-fs-crunch. Do not edit. *)
  
  let entries : Eio_fs.Crunch.t =
    Eio_fs.Crunch.
      [
        Dir { path = "/"; perm = 0o755 };
        File { path = "/index.html"; perm = 0o644; contents = "hello\n" };
        Symlink { path = "/link"; target = "index.html" };
        File { path = "/run.sh"; perm = 0o755; contents = "#!/bin/sh\n" };
        Dir { path = "/static"; perm = 0o755 };
        File { path = "/static/site.css"; perm = 0o644; contents = "body {}\n" };
      ]
  
  let load () = Eio_fs.Crunch.load entries



-o writes the module and its interface instead of printing to standard
output.

  $ eio-fs-crunch -o assets.ml tree
  $ head -1 assets.ml
  (* Generated by eio-fs-crunch. Do not edit. *)
  $ cat assets.mli
  (* Generated by eio-fs-crunch. Do not edit. *)
  
  val entries : Eio_fs.Crunch.t
  (** The embedded file tree. *)
  
  val load : unit -> [ `Close | Eio.Fs.dir_ty ] Eio.Path.t
  (** [load ()] is the root of a new in-memory filesystem holding
      {!entries}. *)



Crunching a non-directory is an error.

  $ eio-fs-crunch tree/index.html 2>&1 | normalize_quotes | grep 'not a directory'
  eio-fs-crunch: DIR argument: tree/index.html is not a directory
